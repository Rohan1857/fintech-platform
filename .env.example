# Application configuration
HTTP_PORT=8080
METRICS_PORT=9090
LOG_LEVEL=info
API_AUTH_TOKEN=slice-secret-token-2026

# Database
DATABASE_URL=postgres://ledger:ledger_password@localhost:5432/ledger?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_PAYMENT_TOPIC=payment.events
KAFKA_DLQ_TOPIC=payment.dlq
KAFKA_CONSUMER_GROUP=payment-processor-group

# Fraud Detection Policies
FRAUD_REVIEW_THRESHOLD=50.0
FRAUD_REJECT_THRESHOLD=80.0
FRAUD_HIGH_VALUE_THRESHOLD_INR=5000000 # 50,000 INR in minor units (paise)
FRAUD_VELOCITY_WINDOW_SECONDS=300
FRAUD_VELOCITY_MAX_COUNT=5
FRAUD_VELOCITY_MAX_AMOUNT_INR=20000000 # 200,000 INR in minor units (paise)
FRAUD_FAIL_CLOSED=true
