# Variables consumed by cmd/server/main.go; local demo defaults.
# Go does not load this file automatically. Export values in your shell.
HTTP_PORT=8090
# Required private value, for example from: openssl rand -hex 32
API_AUTH_TOKEN=
ALLOW_IN_MEMORY_DEV_MODE=false
DATABASE_URL=postgres://ledger:ledger_password@localhost:5432/ledger?sslmode=disable
REDIS_URL=localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_PAYMENT_TOPIC=payment.events
KAFKA_DLQ_TOPIC=payment.dlq
KAFKA_CONSUMER_GROUP=payment-processor-group
FRAUD_FAIL_CLOSED=true

# Test/loadtest: use disposable services, including DATABASE_URL above.
REDIS_ADDR=localhost:6379
# Demo: Compose maps 8080; native Go defaults to 8090.
BASE_URL=http://localhost:8090
